# ── Live-mode keys. Every one is OPTIONAL — without it, that stage runs in
# ── deterministic fixture mode so the whole pipeline still works end-to-end.
# ── Copy to .env.local and fill in.

# OpenAI — event-gate (gpt-4o-mini) + extraction (gpt-4o)
# platform.openai.com → API keys → Create new secret key (needs ~$5 credit)
OPENAI_API_KEY=

# Apify — Instagram scraping (apify/instagram-scraper)
# apify.com → Console → Settings → API & Integrations → Personal API token
APIFY_TOKEN=

# Google Places API (New) — venue resolution → place_id + lat/lng
# console.cloud.google.com → enable "Places API (New)" → Credentials → API key
GOOGLE_PLACES_API_KEY=

# Supabase Postgres. Unset = embedded PGlite (zero-setup local + demo).
# supabase.com → project → Settings → Database → Connection string →
# "Transaction pooler" (port 6543) → paste with your DB password, e.g.
# postgresql://postgres.abcdefgh:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Auth for the autonomous cron trigger (/api/cron/ingest).
# Any random string; Vercel sends it automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=
